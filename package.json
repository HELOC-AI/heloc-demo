{
  "name": "heloc-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' --filter '!@heloc/email-inbound' dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "check:env": "node scripts/check-env-examples.ts",
    "check:contracts": "node scripts/check-email-contract.ts",
    "smoke": "node scripts/smoke.ts",
    "ops": "node scripts/ops.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@heloc/config": "workspace:*",
    "@heloc/contracts": "workspace:*",
    "@heloc/logger": "workspace:*",
    "@heloc/ops": "workspace:*",
    "@heloc/server-kit": "workspace:*",
    "@types/node": "^24.13.6",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "railway": "^3.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
