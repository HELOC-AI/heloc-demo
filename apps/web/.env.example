# Public, inlined into the browser bundle at build time. Never put secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only (never NEXT_PUBLIC_): used by /ops to read monitoring data; never sent to the browser.
# intake's operator key for GET /v1/ops/leads (same value as intake's OPS_API_KEY).
OPS_API_KEY=
# Better Stack read-only SQL query connection (alerts and 24h stats); all three or none.
BETTERSTACK_QUERY_HOST=
BETTERSTACK_QUERY_USERNAME=
BETTERSTACK_QUERY_PASSWORD=
# Optional overrides for health checks; default to production (intake: NEXT_PUBLIC_API_URL).
INTAKE_URL=
FIGURE_URL=
CHASE_URL=
EMAIL_URL=
WEB_URL=
