{
  "$schema": "https://backboard.railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @heloc/chase... --if-present run build",
    "watchPatterns": ["/apps/chase/**", "/packages/**", "/pnpm-lock.yaml", "/.node-version"]
  },
  "deploy": {
    "startCommand": "node apps/chase/src/main.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
