# Copy to .env and fill from the password manager. Never commit .env.
# Variable reference: docs/CONFIGURATION.md

PORT=4002
HOST=::
LOG_LEVEL=info
LOG_PRETTY=true

# Better Stack (optional locally; logs stay on stdout without them)
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_ERRORS_DSN=

# openssl rand -hex 32. Secret; intake's CHASE_API_KEY must match.
INTERNAL_API_KEY=

EMAIL_SERVICE_URL=http://localhost:4003
# = email INTERNAL_API_KEY. Secret.
EMAIL_SERVICE_API_KEY=

# Base Reply Address; each Chase replies to reply+<chase_id>@… (Cloudflare Email Routing).
CHASE_REPLY_ADDRESS=reply@linkerclaw.ai
