# Copy to .env and fill from the password manager. Never commit .env.
# Variable reference: docs/CONFIGURATION.md

PORT=4003
HOST=::
LOG_LEVEL=info
LOG_PRETTY=true

# Better Stack (optional locally; logs stay on stdout without them)
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_ERRORS_DSN=

# openssl rand -hex 32. Secret; chase's EMAIL_SERVICE_API_KEY must match.
INTERNAL_API_KEY=

# resend | console (console = log instead of sending; no key needed)
EMAIL_PROVIDER=console
# Resend API key with "Sending access" only. Secret.
RESEND_API_KEY=
EMAIL_FROM=HELOC Demo <onboarding@resend.dev>
