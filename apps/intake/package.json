{
  "name": "@heloc/intake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@heloc/config": "workspace:*",
    "@heloc/contracts": "workspace:*",
    "@heloc/logger": "workspace:*",
    "@heloc/server-kit": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "drizzle-kit": "^0.31.11"
  }
}
