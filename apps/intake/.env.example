# Copy to .env and fill from the password manager. Never commit .env.
# Variable reference: docs/CONFIGURATION.md

PORT=4000
HOST=::
LOG_LEVEL=info
LOG_PRETTY=true

# Better Stack (optional locally; logs stay on stdout without them)
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
BETTERSTACK_ERRORS_DSN=

# Supabase Postgres — Session pooler URL (IPv4). Secret.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

FIGURE_API_URL=http://localhost:4001
# = figure-mock INTERNAL_API_KEY. Secret.
FIGURE_API_KEY=

CHASE_API_URL=http://localhost:4002
# = chase INTERNAL_API_KEY. Secret.
CHASE_API_KEY=

CORS_ORIGINS=http://localhost:3000
ALLOW_MOCK_OVERRIDE=true
